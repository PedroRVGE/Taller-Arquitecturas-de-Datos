# Variables que usan Airflow, los scripts de extracción y dbt en la EC2.
# NO se completa a mano: el script de arranque de la EC2 genera /opt/de-aws/dw/.env con
#   1) el secreto <proyecto>-<entorno>-dw/app de Secrets Manager (contraseñas y endpoints)
#   2) artifacts/config/<proyecto>-<entorno>-dw.env del bucket (configuración no secreta)
# Este archivo documenta cada variable con valores de ejemplo. Nunca versione un .env real.

# ---- Secrets Manager (Terraform: dw/terraform/secrets.tf)
MYSQL_HOST=de-aws-dev-dw-mysql.xxxxxxxx.us-east-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce
MYSQL_USER=etl_admin
MYSQL_PASSWORD=cambiar
MONGODB_URI=mongodb://docdb_admin:cambiar@de-aws-dev-dw-docdb.cluster-xxxx.us-east-1.docdb.amazonaws.com:27017/?tls=true&tlsCAFile=/opt/certs/global-bundle.pem&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
MONGO_DATABASE=ecommerce
REDSHIFT_HOST=de-aws-dev-dw-wg.123456789012.us-east-1.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=ecommerce_dw
REDSHIFT_USER=dw_admin
REDSHIFT_PASSWORD=cambiar
AIRFLOW_FERNET_KEY=generada-por-terraform
AIRFLOW_SECRET_KEY=generada-por-terraform
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=cambiar
POSTGRES_USER=airflow
POSTGRES_PASSWORD=cambiar

# ---- Configuración no secreta (Terraform: dw/terraform/airflow.tf)
AWS_DEFAULT_REGION=us-east-1
DW_BUCKET=de-aws-dev-dw-123456789012-a1b2c3
REDSHIFT_IAM_ROLE_ARN=arn:aws:iam::123456789012:role/de-aws-dev-dw-redshift-s3
AIRFLOW_UID=50000
AIRFLOW_UI_PORT=8080
PIPELINE_TIMEZONE=America/Bogota
