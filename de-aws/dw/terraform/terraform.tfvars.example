# Copia este archivo a terraform.tfvars (no se versiona) y ajusta los valores.
aws_region   = "us-east-1"
project_name = "de-aws"
environment  = "dev"
owner        = "tu-usuario"

# Tu IP pública: curl -s https://checkip.amazonaws.com
# Vacío = la UI de Airflow solo se abre por túnel de SSM.
allowed_cidrs = ["203.0.113.10/32"]

airflow_instance_type = "t3.large"
rds_instance_class    = "db.t4g.micro"
docdb_instance_class  = "db.t3.medium"

redshift_base_capacity         = 8
redshift_daily_rpu_hours_limit = 16
redshift_publicly_accessible   = true

# QuickSight (opcional): ARN del usuario tras suscribirse a QuickSight.
# quicksight_principal_arn = "arn:aws:quicksight:us-east-1:123456789012:user/default/mi-usuario"

# AWS Academy / Learner Lab (no permite crear roles IAM):
# existing_instance_profile_name = "LabInstanceProfile"
# existing_redshift_role_arn     = "arn:aws:iam::123456789012:role/LabRole"
