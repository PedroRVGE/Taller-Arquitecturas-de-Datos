# Variables del Airflow del data lake en la EC2. NO se completa a mano: la EC2 genera
# /opt/de-aws/dl/.env desde Secrets Manager (<proyecto>-<entorno>-dl/app) y desde
# artifacts/config/<proyecto>-<entorno>-dl.env del bucket. Los permisos sobre S3, Glue,
# Athena y Comprehend vienen del rol IAM de la instancia: no hay llaves de acceso.

# ---- Secrets Manager (Terraform: dl/terraform/secrets.tf)
AIRFLOW_FERNET_KEY=generada-por-terraform
AIRFLOW_SECRET_KEY=generada-por-terraform
AIRFLOW_ADMIN_USERNAME=airflow
AIRFLOW_ADMIN_PASSWORD=cambiar
POSTGRES_USER=airflow
POSTGRES_PASSWORD=cambiar

# ---- Configuración no secreta (Terraform: dl/terraform/airflow.tf)
AWS_DEFAULT_REGION=us-east-1
LAKE_BUCKET=de-aws-dev-dl-123456789012-a1b2c3
GLUE_DATABASE=news_lake
ATHENA_WORKGROUP=de-aws-dev-dl
PIPELINE_SCHEDULE=*/30 * * * *
AIRFLOW_UID=50000
AIRFLOW_UI_PORT=8080
